#!/usr/bin/env bash
#PBS -N fig5_stat_de
#PBS -q batch
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=01:00:00
#PBS -o /gpfs/data/gao/Covid-eccDNA/Revise/chromatin/logs/figure5_statistical_de.o
#PBS -e /gpfs/data/gao/Covid-eccDNA/Revise/chromatin/logs/figure5_statistical_de.e

# Alternative evidence-focused Figure 5.  Panels a--c are the exact approved
# mei layer; d/e use the completed candidate ranking and primary junction-EA
# matrix.  No statistics or selection decisions are recomputed by this job.
set -euo pipefail

OUTDIR=/gpfs/data/gao/Covid-eccDNA/Revise/chromatin
RANKING=/gpfs/data/gao/Covid-eccDNA/Revise/BCL3/tables/chromatin_display_candidate_ranking.tsv
PRIMARY_EA=/gpfs/data/gao/Covid-eccDNA/Revise/eccGene/matrices/junction_EA.tsv
METADATA=/gpfs/data/gao/Covid-eccDNA/Revise/eccGene/sample_metadata.tsv
LOCKED_ABC=$OUTDIR/inputs/Figure_5_abc_locked_mei_600dpi.png
LOCKED_ABC_PDF=$OUTDIR/inputs/Figure_5_abc_locked_mei.pdf
PYTHON_BIN=/public/opt/miniforge3_2024/bin/python

unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
module load Miniforge3_2024 >/dev/null 2>&1 || true

cd "$OUTDIR"
"$PYTHON_BIN" -u scripts/make_figure5_locked_abc_statistical_de.py \
  --outdir "$OUTDIR" \
  --ranking "$RANKING" \
  --primary-ea "$PRIMARY_EA" \
  --metadata "$METADATA" \
  --locked-png "$LOCKED_ABC" \
  --locked-pdf "$LOCKED_ABC_PDF" \
  --stem figure5_statistical_de_v1
