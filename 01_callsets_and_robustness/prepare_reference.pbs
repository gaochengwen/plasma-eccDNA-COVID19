#!/usr/bin/env bash
#PBS -N CF_hg38_ref
#PBS -q batch
#PBS -l nodes=1:ppn=8
#PBS -l mem=96gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/gpfs/data/gao/Covid-eccDNA/Revise/Circle_finder
SOURCE=/gpfs/resources/gnomAD/gnomADv4.1genome/reference.fasta.gz
OUTDIR="$ROOT/reference"
REFERENCE="$OUTDIR/hg38.canonical.fa"
LOG="$ROOT/logs/reference_build.log"

mkdir -p "$OUTDIR" "$ROOT/logs"
: > "$LOG"
exec >> "$LOG" 2>&1

module load samtools-1.17 >/dev/null 2>&1
module load bwa-0.7.17 >/dev/null 2>&1

echo "started_utc=$(date -u +%FT%TZ)"
echo "host=$(hostname)"
echo "source=$SOURCE"
samtools --version | awk 'NR <= 2'
bwa 2>&1 | awk '/Version:/ {print}' || true
ulimit -a

test -s "$SOURCE"
test -s "$SOURCE.fai"

if [[ ! -s "$REFERENCE" ]]; then
    samtools faidx "$SOURCE" \
        chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 \
        chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 \
        chrX chrY chrM > "$REFERENCE"
fi

samtools faidx "$REFERENCE"

cat > "$OUTDIR/expected_canonical_lengths.tsv" <<'EOF'
chr1	248956422
chr2	242193529
chr3	198295559
chr4	190214555
chr5	181538259
chr6	170805979
chr7	159345973
chr8	145138636
chr9	138394717
chr10	133797422
chr11	135086622
chr12	133275309
chr13	114364328
chr14	107043718
chr15	101991189
chr16	90338345
chr17	83257441
chr18	80373285
chr19	58617616
chr20	64444167
chr21	46709983
chr22	50818468
chrX	156040895
chrY	57227415
chrM	16569
EOF

cut -f1,2 "$REFERENCE.fai" > "$OUTDIR/observed_canonical_lengths.tsv"
cmp "$OUTDIR/expected_canonical_lengths.tsv" \
    "$OUTDIR/observed_canonical_lengths.tsv"

if [[ ! -s "$REFERENCE.bwt" ]]; then
    set +e
    /usr/bin/time -v bwa index -a bwtsw "$REFERENCE"
    bwa_status=$?
    set -e
    echo "bwa_index_exit_status=$bwa_status"
    ls -lh "$REFERENCE".* || true
    if [[ "$bwa_status" -ne 0 ]]; then
        exit "$bwa_status"
    fi
fi

sha256sum "$SOURCE.fai" "$REFERENCE" "$REFERENCE.fai" \
    "$REFERENCE.amb" "$REFERENCE.ann" "$REFERENCE.bwt" \
    "$REFERENCE.pac" "$REFERENCE.sa" > "$OUTDIR/reference_sha256.tsv"

echo "completed_utc=$(date -u +%FT%TZ)"
touch "$OUTDIR/.reference_complete"
