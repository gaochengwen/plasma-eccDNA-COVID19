#!/usr/bin/env bash
#PBS -N CM_sensitivity
#PBS -q batch
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT=/gpfs/data/gao/Covid-eccDNA/Revise/Circle_finder
LOG="$ROOT/logs/circlemap_sensitivity.log"
mkdir -p "$ROOT/logs"
exec > >(tee "$LOG") 2>&1

cd "$ROOT"
/gpfs/home/gaochengwen/bin/python3 \
    scripts/build_circlemap_sensitivity.py \
    --manifest manifests/eccdna_sample_manifest.tsv \
    --output-dir "$ROOT"
