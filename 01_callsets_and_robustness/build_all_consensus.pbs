#!/usr/bin/env bash
#PBS -N CF_all_cons
#PBS -q batch
#PBS -l nodes=1:ppn=1
#PBS -l mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

set -euo pipefail

ROOT=/gpfs/data/gao/Covid-eccDNA/Revise/Circle_finder
mkdir -p "$ROOT/logs"

/public/opt/miniforge3_2024/bin/python \
  "$ROOT/scripts/build_consensus_callsets.py" \
  --root "$ROOT" \
  --manifest "$ROOT/manifests/eccdna_sample_manifest.tsv" \
  --label all \
  >> "$ROOT/logs/build_all_consensus.log" 2>&1
